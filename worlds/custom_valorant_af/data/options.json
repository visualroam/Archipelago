{
    "$schema": "https://github.com/ManualForArchipelago/Manual/raw/main/schemas/Manual.options.schema.json",
    "core": {
        "death_link": {
            "default": false
        }
    },
    "user": {
        "goal_agents": {
            "type": "Range",
            "display_name": "Agenten fürs Ziel",
            "description": [
                "Wie viele Agenten (inkl. Start-Agent) für das Ziel freigeschaltet sein müssen."
            ],
            "range_start": 1,
            "range_end": 29,
            "default": 15
        },
        "goal_weapons": {
            "type": "Range",
            "display_name": "Waffen fürs Ziel",
            "description": [
                "Wie viele Waffen (Classic zählt nicht) für das Ziel freigeschaltet sein müssen."
            ],
            "range_start": 0,
            "range_end": 18,
            "default": 10
        },
        "swiftplay_counts": {
            "type": "Toggle",
            "display_name": "Swiftplay zählt",
            "description": [
                "Nur für den op.gg Client: Zählen Swiftplay-Spiele zusätzlich zu Unrated für Win, Match MVP, Kill Bomb und Ziel?"
            ],
            "default": false
        },
        "kill_bomb": {
            "type": "Range",
            "display_name": "Kills für Kill Bomb",
            "description": [
                "Wie viele Kills in einem Match der Check Kill Bomb braucht."
            ],
            "range_start": 10,
            "range_end": 40,
            "default": 25
        }
    }
}